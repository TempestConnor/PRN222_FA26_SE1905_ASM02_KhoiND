@page "{id:guid?}"
@model HorseClub.RazorWebApp.KhoiND.Pages.Horses.DeleteModel
@{
    ViewData["Title"] = "Delete horse";
}

<h1>Delete horse</h1>

@if (Model.Error != null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<p class="lead">Are you sure you want to delete <strong>@Model.Horse.Name</strong>?</p>
<hr />

<partial name="_HorseDetails" model="Model.Horse" />

<form method="post" class="d-flex gap-2">
    <input type="hidden" name="id" value="@Model.Horse.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to list</a>
</form>
