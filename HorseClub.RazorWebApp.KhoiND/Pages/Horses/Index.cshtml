@page
@model HorseClub.RazorWebApp.KhoiND.Pages.Horses.IndexModel
@{
    ViewData["Title"] = "Horses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Horses</h1>
    <a asp-page="Create" class="btn btn-primary">New horse</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input asp-for="Name" class="form-control" placeholder="Name" />
    </div>
    <div class="col-md-3">
        <input asp-for="Breed" class="form-control" placeholder="Breed" />
    </div>
    <div class="col-md-3">
        <input asp-for="OwnerName" class="form-control" placeholder="Owner name" />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@* site.js re-fetches this page and swaps this block when the hub reports a change. *@
<div id="horse-list">
    @if (Model.Horses.Count == 0)
    {
        <div class="alert alert-info">No horses found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Microchip No</th>
                        <th>Sex</th>
                        <th>Breed</th>
                        <th>Color</th>
                        <th>Birth date</th>
                        <th>Status</th>
                        <th>Owner</th>
                        <th>Sire</th>
                        <th>Dam</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Horses)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.MicrochipNo</td>
                            <td>@((HorseSex)item.Sex)</td>
                            <td>@item.Breed</td>
                            <td>@item.Color</td>
                            <td>@item.BirthDate.ToString("yyyy-MM-dd")</td>
                            <td>@((HorseStatus)item.Status)</td>
                            <td>@item.Owner?.FullName</td>
                            <td>@item.Sire?.Name</td>
                            <td>@item.Dam?.Name</td>
                            <td class="text-nowrap">
                                <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small">@Model.Horses.Count horse(s)</p>
    }
</div>
